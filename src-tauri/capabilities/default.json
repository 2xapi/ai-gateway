{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions for the main window and usage overlay",
  "windows": [
    "main",
    "usage-overlay"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:8787/*",
      "http://localhost:8787/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position"
  ]
}
